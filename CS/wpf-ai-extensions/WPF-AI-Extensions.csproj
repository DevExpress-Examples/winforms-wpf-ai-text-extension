<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WPF_AI_Extensions</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.2.0-beta.5" />
    <PackageReference Include="DevExpress.AIIntegration.Wpf" Version="26.1.5" />
    <PackageReference Include="DevExpress.Wpf" Version="26.1.5" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="WPF.docx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
